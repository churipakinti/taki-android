<?xml version="1.0" encoding="utf-8"?>
<!-- Targeting Android 11 or lower -->
<full-backup-content>
    <!-- The following "exclude" elements are not part of the auto backup -->
    <exclude domain="root"/>
    <!-- Exclude specific shared preferences that contain GCM registration Id -->

    <!-- The following "include" elements are part of the auto backup -->
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>

    <!--
      ultrasonic-database stores ServerSetting rows (url, userName, password in plaintext,
      see ServerSetting.kt / AppDatabase.kt). Excluded so a legacy (API <= 31) full backup/
      restore can never recover server credentials. The per-server metadata caches
      (ultrasonic-database-meta-<id>, track/album/artist listings only, no credentials) are NOT
      excluded and remain backed up. TAKI_BETA_COMPLETION_PLAN.md P0.2. Must stay after the
      broader database include above: later rules win for the same path.
    -->
    <exclude domain="database" path="ultrasonic-database"/>
    <exclude domain="database" path="ultrasonic-database-wal"/>
    <exclude domain="database" path="ultrasonic-database-shm"/>
    <exclude domain="database" path="ultrasonic-database-journal"/>
</full-backup-content>
