<?xml version="1.0" encoding="utf-8"?>
<!--
    Collection Detail hero section: fixed, does not scroll away with the disc grid below it -
    deliberately simpler than making it a spanning first item in the grid's adapter, and it only
    ever loads up to 3 covers once.
-->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:gravity="center_horizontal"
    a:orientation="vertical"
    a:paddingHorizontal="48dp"
    a:paddingTop="@dimen/space_lg"
    a:paddingBottom="@dimen/space_sm">

    <FrameLayout
        a:layout_width="152dp"
        a:layout_height="152dp">

        <include
            a:id="@+id/collection_header_artwork"
            layout="@layout/view_stacked_artwork" />

    </FrameLayout>

    <TextView
        a:id="@+id/collection_header_title"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/space_lg"
        a:ellipsize="end"
        a:gravity="center"
        a:maxLines="2"
        a:textAppearance="@style/TextAppearance.Taki.Hero"
        tools:text="Bach 333" />

    <TextView
        a:id="@+id/collection_header_subtitle"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/space_xs"
        a:gravity="center"
        a:textAppearance="@style/TextAppearance.Taki.Caption"
        tools:text="222 discs" />

</LinearLayout>
