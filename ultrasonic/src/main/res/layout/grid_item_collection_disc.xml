<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:layout_marginHorizontal="@dimen/space_sm"
    a:layout_marginVertical="@dimen/space_sm"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            a:id="@+id/cover_art"
            a:layout_width="match_parent"
            a:layout_height="0dp"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Small" />

        <LinearLayout
            a:id="@+id/row_disc_details"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:gravity="center_vertical"
            a:orientation="vertical"
            a:paddingTop="@dimen/space_sm"
            a:paddingBottom="@dimen/space_xs"
            app:layout_constraintEnd_toEndOf="@id/cover_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cover_art">

            <TextView
                a:id="@+id/disc_position"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="Disc 057" />

            <TextView
                a:id="@+id/disc_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_text_tight"
                a:ellipsize="end"
                a:maxLines="2"
                a:minLines="2"
                a:textAppearance="@style/TextAppearance.Taki.TitleSmall"
                tools:text="Cantatas 150, 4, 71, 106" />

            <TextView
                a:id="@+id/disc_track_count"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="18 tracks" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
