<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:orientation="vertical"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:paddingHorizontal="24dp"
    a:paddingTop="20dp"
    a:paddingBottom="16dp">

    <TextView
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:paddingBottom="12dp"
        a:text="@string/equalizer.label"
        a:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <CheckBox
        a:id="@+id/equalizer_enabled"
        style="@style/Ultrasonic.PrimaryText"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:text="@string/equalizer.enabled"
        a:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

    <ScrollView
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:clipToPadding="false">

        <LinearLayout
            a:orientation="vertical"
            a:layout_width="match_parent"
            a:layout_height="wrap_content">

            <LinearLayout
                a:id="@+id/equalizer_layout"
                a:orientation="vertical"
                a:layout_width="match_parent"
                a:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                a:id="@+id/equalizer_preset"
                style="?attr/materialButtonOutlinedStyle"
                a:text="@string/equalizer.preset"
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_gravity="center"
                a:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
