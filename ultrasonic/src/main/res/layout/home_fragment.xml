<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/swipe_refresh_view"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    tools:context="org.moire.ultrasonic.fragment.HomeFragment">

    <androidx.core.widget.NestedScrollView
        a:layout_width="match_parent"
        a:layout_height="match_parent">

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:paddingBottom="@dimen/space_xl">

            <LinearLayout
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                a:layout_marginTop="@dimen/space_lg"
                a:layout_marginBottom="@dimen/space_sm"
                a:gravity="center_vertical"
                a:orientation="horizontal">

                <TextView
                    a:id="@+id/home_greeting"
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:textAppearance="@style/TextAppearance.Taki.Hero"
                    tools:text="@string/home.greeting_morning" />

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/home_overflow"
                    style="@style/Widget.Material3.Button.IconButton"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:contentDescription="@string/library_hub.title"
                    app:icon="@drawable/ic_more_vert"
                    app:iconSize="@dimen/icon_size_md"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <HorizontalScrollView
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_xs"
                a:scrollbars="none">

                <LinearLayout
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:orientation="horizontal"
                    a:paddingHorizontal="@dimen/space_screen_horizontal">

                    <com.google.android.material.button.MaterialButton
                        a:id="@+id/home_quick_playlists"
                        style="@style/Widget.Taki.NeutralChip"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:layout_marginEnd="@dimen/space_sm"
                        a:text="@string/playlist.label" />

                    <com.google.android.material.button.MaterialButton
                        a:id="@+id/home_quick_albums"
                        style="@style/Widget.Taki.NeutralChip"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:layout_marginEnd="@dimen/space_sm"
                        a:text="@string/main.albums_title" />

                    <com.google.android.material.button.MaterialButton
                        a:id="@+id/home_quick_artists"
                        style="@style/Widget.Taki.NeutralChip"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:layout_marginEnd="@dimen/space_sm"
                        a:text="@string/main.artists_title" />

                    <com.google.android.material.button.MaterialButton
                        a:id="@+id/home_quick_songs"
                        style="@style/Widget.Taki.NeutralChip"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:layout_marginEnd="@dimen/space_sm"
                        a:text="@string/main.songs_title" />

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                a:id="@+id/home_shortcuts_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                    a:layout_marginTop="@dimen/space_section_gap"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/main.albums_recent"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/home_shortcuts_list"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:nestedScrollingEnabled="false"
                    a:paddingHorizontal="@dimen/space_md"
                    tools:listitem="@layout/home_shortcut_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/home_mix_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                a:layout_marginTop="@dimen/space_section_gap"
                a:background="@drawable/bg_home_shortcut_item"
                a:clickable="true"
                a:focusable="true"
                a:gravity="center_vertical"
                a:orientation="horizontal"
                a:padding="@dimen/space_sm">

                <com.google.android.material.imageview.ShapeableImageView
                    a:id="@+id/home_mix_cover"
                    a:layout_width="64dp"
                    a:layout_height="64dp"
                    a:layout_marginEnd="@dimen/space_md"
                    a:contentDescription="@string/albumArt"
                    a:scaleType="centerCrop"
                    a:src="@drawable/unknown_album"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Small" />

                <LinearLayout
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:layout_marginEnd="@dimen/space_sm"
                    a:orientation="vertical">

                    <TextView
                        a:id="@+id/home_mix_title"
                        a:layout_width="match_parent"
                        a:layout_height="wrap_content"
                        a:ellipsize="end"
                        a:singleLine="true"
                        a:textAppearance="@style/TextAppearance.Taki.Title"
                        tools:text="Mix: Reggae" />

                    <TextView
                        a:id="@+id/home_mix_subtitle"
                        a:layout_width="match_parent"
                        a:layout_height="wrap_content"
                        a:ellipsize="end"
                        a:singleLine="true"
                        a:textAppearance="@style/TextAppearance.Taki.Caption"
                        tools:text="25 songs" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/home_mix_play"
                    style="@style/Widget.Material3.Button.IconButton"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:contentDescription="@string/home.mix_play"
                    app:icon="@drawable/media_start"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/home_mix_shuffle"
                    style="@style/Widget.Material3.Button.IconButton"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:contentDescription="@string/home.mix_regenerate"
                    app:icon="@drawable/media_shuffle"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorOnSurface" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/home_favorites_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                    a:layout_marginTop="@dimen/space_section_gap"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/main.albums_starred"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/home_favorites_list"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:listitem="@layout/home_carousel_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/home_newest_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                    a:layout_marginTop="@dimen/space_section_gap"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/main.albums_newest"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/home_newest_list"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:listitem="@layout/home_carousel_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/home_random_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                    a:layout_marginTop="@dimen/space_section_gap"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/home.discover_title"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/home_random_list"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:listitem="@layout/home_carousel_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/home_frequent_shelf"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_screen_horizontal"
                    a:layout_marginTop="@dimen/space_section_gap"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/main.albums_frequent"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/home_frequent_list"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:listitem="@layout/home_carousel_item" />

            </LinearLayout>

            <TextView
                a:id="@+id/home_empty_view"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_2xl"
                a:gravity="center"
                a:padding="@dimen/space_2xl"
                a:text="@string/select_album.empty"
                a:textAppearance="@style/TextAppearance.Taki.Body"
                a:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
