<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical"
    a:paddingHorizontal="24dp"
    a:paddingTop="4dp">

    <com.google.android.material.textfield.TextInputLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:hint="@string/common.name">

        <com.google.android.material.textfield.TextInputEditText
            a:id="@+id/get_playlist_name"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:importantForAutofill="no"
            a:inputType="textCapSentences"
            a:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="12dp"
        a:hint="@string/common.comment">

        <com.google.android.material.textfield.TextInputEditText
            a:id="@+id/get_playlist_comment"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:importantForAutofill="no"
            a:inputType="textCapSentences"
            a:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        a:id="@+id/get_playlist_public"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:checked="false"
        a:text="@string/common.public" />

</LinearLayout>
