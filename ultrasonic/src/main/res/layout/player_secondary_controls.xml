<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:layout_marginTop="@dimen/player_section_spacing"
    a:gravity="center"
    a:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        a:id="@+id/button_save_playlist"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="@dimen/player_secondary_target"
        a:layout_height="@dimen/player_secondary_target"
        a:layout_marginHorizontal="@dimen/player_secondary_spacing"
        a:contentDescription="@string/download.menu_save"
        app:icon="@drawable/ic_add_white"
        app:iconSize="@dimen/player_secondary_icon"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/button_lyrics"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="@dimen/player_secondary_target"
        a:layout_height="@dimen/player_secondary_target"
        a:layout_marginHorizontal="@dimen/player_secondary_spacing"
        a:contentDescription="@string/download.menu_lyrics"
        app:icon="@drawable/ic_library"
        app:iconSize="@dimen/player_secondary_icon"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/button_queue"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="@dimen/player_secondary_target"
        a:layout_height="@dimen/player_secondary_target"
        a:layout_marginHorizontal="@dimen/player_secondary_spacing"
        a:contentDescription="@string/buttons.queue"
        app:icon="@drawable/media_toggle_list"
        app:iconSize="@dimen/player_secondary_icon"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/button_sleep_timer"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="@dimen/player_secondary_target"
        a:layout_height="@dimen/player_secondary_target"
        a:layout_marginHorizontal="@dimen/player_secondary_spacing"
        a:contentDescription="@string/sleep_timer.title"
        app:icon="@drawable/ic_sleep_timer"
        app:iconSize="@dimen/player_secondary_icon"
        app:iconTint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
