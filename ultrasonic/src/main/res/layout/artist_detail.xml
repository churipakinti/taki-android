<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/swipe_refresh_view"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    tools:context="org.moire.ultrasonic.fragment.ArtistDetailFragment">

    <androidx.core.widget.NestedScrollView
        a:id="@+id/artist_detail_scroll"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:fillViewport="true">

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:paddingBottom="@dimen/space_2xl">

            <FrameLayout
                a:id="@+id/artist_detail_hero"
                a:layout_width="match_parent"
                a:layout_height="300dp">

                <ImageView
                    a:id="@+id/artist_detail_art"
                    a:layout_width="match_parent"
                    a:layout_height="match_parent"
                    a:contentDescription="@string/artist.artwork_description"
                    a:scaleType="centerCrop"
                    a:src="@drawable/artist_placeholder" />

                <View
                    a:layout_width="match_parent"
                    a:layout_height="match_parent"
                    a:background="@drawable/bg_artist_hero_gradient"
                    a:importantForAccessibility="no" />

                <LinearLayout
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:layout_gravity="bottom"
                    a:orientation="vertical"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_lg"
                    a:paddingBottom="@dimen/space_lg">

                    <TextView
                        a:id="@+id/artist_detail_name"
                        a:layout_width="match_parent"
                        a:layout_height="wrap_content"
                        a:maxLines="2"
                        a:shadowColor="#99000000"
                        a:shadowDx="0"
                        a:shadowDy="1"
                        a:shadowRadius="3"
                        a:textAppearance="@style/TextAppearance.Taki.Title"
                        tools:text="Héroes del Silencio" />

                    <TextView
                        a:id="@+id/artist_detail_album_count"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:layout_marginTop="@dimen/space_xs"
                        a:textAppearance="@style/TextAppearance.Taki.Caption"
                        a:visibility="invisible"
                        tools:text="8 albums"
                        tools:visibility="visible" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:gravity="center_vertical|end"
                a:orientation="horizontal"
                a:paddingStart="@dimen/space_screen_horizontal"
                a:paddingTop="@dimen/space_sm"
                a:paddingEnd="@dimen/space_screen_horizontal"
                a:paddingBottom="@dimen/space_sm">

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/artist_detail_download"
                    style="@style/Widget.Material3.Button.IconButton"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:contentDescription="@string/artist.download_description"
                    app:icon="@drawable/ic_menu_download"
                    app:iconSize="@dimen/icon_size_sm"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/artist_detail_radio"
                    style="@style/Widget.Material3.Button.IconButton"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:layout_marginEnd="@dimen/space_xs"
                    a:contentDescription="@string/artist.radio_description"
                    app:icon="@drawable/ic_radio"
                    app:iconSize="@dimen/icon_size_sm"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    a:id="@+id/artist_detail_play"
                    a:layout_width="@dimen/touch_target_min"
                    a:layout_height="@dimen/touch_target_min"
                    a:contentDescription="@string/artist.play_description"
                    a:src="@drawable/media_start"
                    app:backgroundTint="?attr/colorOnSurface"
                    app:borderWidth="0dp"
                    app:elevation="0dp"
                    app:fabCustomSize="@dimen/touch_target_min"
                    app:maxImageSize="@dimen/icon_size_md"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ultrasonic.Circle"
                    app:tint="?attr/colorSurface" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/artist_detail_popular_section"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginStart="@dimen/space_lg"
                    a:layout_marginTop="@dimen/space_lg"
                    a:layout_marginEnd="@dimen/space_lg"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/artist.popular"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/artist_detail_tracks"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:nestedScrollingEnabled="false"
                    tools:itemCount="5"
                    tools:listitem="@layout/artist_popular_track_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/artist_detail_albums_section"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginStart="@dimen/space_lg"
                    a:layout_marginTop="@dimen/space_xl"
                    a:layout_marginEnd="@dimen/space_lg"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/artist.albums"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/artist_detail_albums"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:itemCount="4"
                    tools:listitem="@layout/home_carousel_item" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/artist_detail_about_section"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical"
                a:visibility="gone"
                tools:visibility="visible">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginStart="@dimen/space_lg"
                    a:layout_marginTop="@dimen/space_xl"
                    a:layout_marginEnd="@dimen/space_lg"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/artist.about"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <TextView
                    a:id="@+id/artist_detail_biography"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:layout_marginHorizontal="@dimen/space_lg"
                    a:ellipsize="end"
                    a:lineSpacingExtra="3dp"
                    a:maxLines="5"
                    a:textAppearance="@style/TextAppearance.Taki.Body"
                    a:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Artist biography supplied by the music server." />

                <com.google.android.material.button.MaterialButton
                    a:id="@+id/artist_detail_biography_toggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    a:layout_width="wrap_content"
                    a:layout_height="@dimen/touch_target_min"
                    a:layout_marginStart="@dimen/space_xs"
                    a:minHeight="@dimen/touch_target_min"
                    a:text="@string/artist.show_more"
                    a:textColor="?attr/colorOnSurface"
                    a:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                a:id="@+id/artist_detail_similar_section"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="vertical"
                a:visibility="gone"
                tools:visibility="visible">

                <TextView
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    a:layout_marginStart="@dimen/space_lg"
                    a:layout_marginTop="@dimen/space_xl"
                    a:layout_marginEnd="@dimen/space_lg"
                    a:layout_marginBottom="@dimen/space_sm"
                    a:text="@string/artist.similar"
                    a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

                <androidx.recyclerview.widget.RecyclerView
                    a:id="@+id/artist_detail_similar"
                    a:layout_width="match_parent"
                    a:layout_height="wrap_content"
                    a:clipToPadding="false"
                    a:paddingStart="@dimen/space_lg"
                    a:paddingEnd="@dimen/space_xs"
                    tools:itemCount="4"
                    tools:listitem="@layout/artist_similar_item" />

            </LinearLayout>

            <TextView
                a:id="@+id/artist_detail_empty"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_2xl"
                a:gravity="center"
                a:padding="@dimen/space_2xl"
                a:text="@string/artist.empty"
                a:textAppearance="@style/TextAppearance.Taki.Body"
                a:textColor="?attr/colorOnSurfaceVariant"
                a:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
