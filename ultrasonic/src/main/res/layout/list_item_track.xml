<?xml version="1.0" encoding="utf-8"?>
<!-- DON'T CONVERT TO ConstraintLayout! We have been there and it was slower than LinearLayout :) -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/song_layout"
    a:layout_width="fill_parent"
    a:layout_height="?android:attr/listPreferredItemHeight"
    a:minHeight="?android:attr/listPreferredItemHeight"
    a:orientation="horizontal">

    <ImageView
        a:id="@+id/song_drag"
        a:layout_width="38dp"
        a:layout_height="fill_parent"
        a:background="@android:color/transparent"
        a:focusable="false"
        a:gravity="center_vertical"
        a:importantForAccessibility="no"
        a:paddingStart="11dip"
        a:paddingEnd="7dip"
        a:src="@drawable/ic_drag_vertical"
        a:visibility="gone" />

    <CheckedTextView
        a:id="@+id/song_check"
        a:layout_width="38dp"
        a:layout_height="fill_parent"
        a:checkMark="@drawable/btn_check_circle"
        a:gravity="center"
        a:paddingEnd="4dip"
        a:visibility="gone" />

    <include layout="@layout/list_item_track_details" />


    <ImageView
        a:id="@+id/song_star"
        a:layout_width="40dp"
        a:layout_height="fill_parent"
        a:background="@android:color/transparent"
        a:contentDescription="@string/download.menu_star"
        a:focusable="false"
        a:gravity="center_vertical"
        a:paddingEnd="5dip"
        a:src="@drawable/rating_star_5" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/song_menu"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="32dp"
        a:layout_height="32dp"
        a:layout_gravity="center_vertical"
        a:contentDescription="@string/search.more"
        app:icon="@drawable/ic_more_vert"
        app:iconSize="16dp"
        app:iconTint="?attr/colorOnSurfaceVariant"
        a:visibility="gone" />

</LinearLayout>