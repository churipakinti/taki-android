<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="fill_parent"
    a:layout_height="fill_parent"
    a:orientation="vertical">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center_vertical"
        a:minHeight="48dp"
        a:orientation="horizontal"
        a:paddingStart="16dp">

        <TextView
            a:id="@+id/select_playlist_count"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            style="@style/Ultrasonic.SecondaryText"
            a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="8 playlists" />

        <org.moire.ultrasonic.view.FilterButtonBar
            a:id="@+id/select_playlist_filter_bar"
            a:layout_width="wrap_content"
            a:layout_height="48dp" />

    </LinearLayout>

    <TextView
        a:id="@+id/select_playlist_empty"
        a:layout_width="fill_parent"
        a:layout_height="wrap_content"
        a:padding="16dip"
        a:text="@string/select_playlist.empty"
        a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        a:visibility="gone"
        tools:visibility="visible" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/select_playlist_refresh"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1.0">

        <GridView
            android:id="@+id/select_playlist_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnWidth="160dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:horizontalSpacing="0dp"
            android:numColumns="1"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:stretchMode="columnWidth"
            android:verticalSpacing="0dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
