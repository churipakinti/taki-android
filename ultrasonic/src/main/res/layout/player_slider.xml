<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical"
    a:layout_marginTop="@dimen/player_section_spacing_large" >
    
    <SeekBar
        a:id="@+id/current_playing_progress_bar"
        a:layout_width="fill_parent"
        a:layout_height="24dp"
        a:indeterminate="false"
        a:progressBackgroundTint="?attr/colorSurfaceContainerHighest"
        a:progressTint="@color/taki_progress"
        a:thumbTint="@color/taki_progress" />

    <RelativeLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/player_time_spacing">

        <TextView
            a:id="@+id/current_playing_position"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_alignParentLeft="true"
            a:layout_marginStart="12dp"
            a:text="@string/util.no_time"
            a:textAppearance="@style/TextAppearance.Material3.BodySmall"
            a:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            a:id="@+id/current_playing_duration"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_alignParentRight="true"
            a:layout_marginEnd="12dp"
            a:text="@string/util.no_time"
            a:textAppearance="@style/TextAppearance.Material3.BodySmall"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="RelativeOverlap" />

    </RelativeLayout>

</LinearLayout>
