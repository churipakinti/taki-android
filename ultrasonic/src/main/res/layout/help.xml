<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:orientation="vertical">

    <ScrollView
        a:layout_width="match_parent"
        a:layout_height="0dp"
        a:layout_weight="1"
        a:fillViewport="true"
        a:scrollbars="vertical">

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:paddingHorizontal="24dp"
            a:paddingTop="28dp"
            a:paddingBottom="16dp">

            <TextView
                a:id="@+id/help_title"
                style="@style/Ultrasonic.PrimaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                tools:text="Taki (4.0.0)" />

            <TextView
                style="@style/Ultrasonic.SecondaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="4dp"
                a:text="@string/about.tagline"
                a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                a:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                a:id="@+id/help_text"
                style="@style/Ultrasonic.SecondaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="20dp"
                a:lineSpacingMultiplier="1.15"
                a:text="@string/about.text"
                a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                a:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingHorizontal="24dp"
        a:paddingTop="8dp"
        a:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            a:id="@+id/help_webpage"
            style="?attr/materialButtonOutlinedStyle"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginBottom="12dp"
            a:text="@string/about.webpage"
            a:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/help_report"
            style="?attr/materialButtonOutlinedStyle"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:text="@string/about.report" />

    </LinearLayout>

</LinearLayout>
