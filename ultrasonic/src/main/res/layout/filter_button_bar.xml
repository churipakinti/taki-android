<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/filter_layout"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    app:layout_constraintBottom_toTopOf="@+id/sort_order_menu"
    app:layout_constraintTop_toTopOf="@+id/sort_order_menu"
    tools:layout_height="match_parent">

    <com.google.android.material.chip.Chip
        a:id="@+id/chip_view_toggle"
        a:layout_width="48dp"
        a:layout_height="48dp"
        a:layout_marginStart="8dp"
        a:contentDescription="@string/list_view"
        a:minWidth="48dp"
        app:chipBackgroundColor="@android:color/transparent"
        app:chipIcon="@drawable/ic_baseline_view_list"
        app:chipIconSize="22dp"
        app:chipEndPadding="8dp"
        app:chipMinHeight="48dp"
        app:chipStartPadding="8dp"
        app:chipStrokeWidth="0dp"
        app:ensureMinTouchTargetSize="false"
        app:iconEndPadding="0dp"
        app:iconStartPadding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sort_order_menu"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textEndPadding="0dp"
        app:textStartPadding="0dp" />

    <LinearLayout
        a:id="@+id/songs_action_row"
        a:layout_width="0dp"
        a:layout_height="48dp"
        a:layout_marginStart="20dp"
        a:layout_marginEnd="20dp"
        a:gravity="center_vertical"
        a:orientation="horizontal"
        a:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            a:id="@+id/songs_sort_order_menu"
            a:layout_width="0dp"
            a:layout_height="48dp"
            a:layout_weight="1"
            a:background="@drawable/bg_songs_play_all_button"
            a:clickable="true"
            a:focusable="true"
            a:gravity="center_vertical"
            a:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                a:id="@+id/songs_sort_order_menu_options"
                a:layout_width="0dp"
                a:layout_height="48dp"
                a:layout_weight="1"
                a:background="@null"
                a:cursorVisible="false"
                a:ellipsize="end"
                a:focusable="false"
                a:includeFontPadding="false"
                a:inputType="none"
                a:paddingStart="16dp"
                a:paddingEnd="8dp"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                a:textColor="?attr/colorOnSurface" />

            <ImageView
                a:layout_width="20dp"
                a:layout_height="20dp"
                a:layout_marginEnd="16dp"
                a:contentDescription="@null"
                a:importantForAccessibility="no"
                a:src="@drawable/ic_songs_selector_arrow"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            a:id="@+id/songs_play_all_button"
            a:layout_width="wrap_content"
            a:layout_height="48dp"
            a:layout_marginStart="12dp"
            a:background="@drawable/bg_songs_play_all_button"
            a:clickable="true"
            a:contentDescription="@string/play_all_songs"
            a:focusable="true"
            a:gravity="center"
            a:orientation="horizontal"
            a:paddingStart="16dp"
            a:paddingEnd="16dp">

            <ImageView
                a:layout_width="20dp"
                a:layout_height="20dp"
                a:contentDescription="@null"
                a:importantForAccessibility="no"
                a:src="@drawable/ic_play_all_compact"
                app:tint="@color/taki_accent" />

            <TextView
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginStart="8dp"
                a:includeFontPadding="false"
                a:text="@string/songs_play_all_label"
                a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                a:textColor="?attr/colorOnSurface" />

        </LinearLayout>

    </LinearLayout>


    <com.google.android.material.textfield.TextInputLayout
        a:id="@+id/sort_order_menu"
        style="@style/Widget.ChipDropdown"
        a:layout_width="wrap_content"
        a:layout_height="48dp"
        a:layout_marginStart="8dp"
        a:layout_marginTop="2dp"
        a:layout_marginEnd="8dp"
        a:layout_marginBottom="2dp"
        a:background="@null"
        a:baselineAligned="false"
        a:ellipsize="marquee"
        a:text="@string/main.albums_newest"
        a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/chip_view_toggle"
        app:layout_constraintTop_toTopOf="parent"
        >

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            a:id="@+id/sort_order_menu_options"
            a:layout_width="wrap_content"
            a:layout_height="48dp"
            a:ellipsize="end"
            a:focusable="false"
            a:inputType="none"
            a:paddingStart="12dp"
            a:paddingTop="0dp"
            a:paddingEnd="12dp"
            a:paddingBottom="0dp"
            a:singleLine="true"
            a:text="@string/main.albums_newest"
            a:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="LabelFor,TouchTargetSizeCheck,TouchTargetSizeCheck" />

    </com.google.android.material.textfield.TextInputLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
