<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        a:layout_width="match_parent"
        a:layout_height="wrap_content" />

    <TextView
        a:id="@+id/album_info_title"
        style="@style/Ultrasonic.PrimaryText"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:paddingHorizontal="24dp"
        a:paddingBottom="16dp"
        a:text="@string/album.info_title"
        a:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center_vertical"
        a:orientation="horizontal"
        a:paddingHorizontal="24dp"
        a:paddingBottom="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            a:id="@+id/album_info_art"
            a:layout_width="56dp"
            a:layout_height="56dp"
            a:layout_marginEnd="12dp"
            a:contentDescription="@string/album.artwork_description"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent" />

        <LinearLayout
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:orientation="vertical">

            <TextView
                a:id="@+id/album_info_name"
                style="@style/Ultrasonic.PrimaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="2"
                a:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                tools:text="Era Vulgaris" />

            <TextView
                a:id="@+id/album_info_artist"
                style="@style/Ultrasonic.SecondaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                a:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Queens of the Stone Age" />

            <TextView
                a:id="@+id/album_info_secondary"
                style="@style/Ultrasonic.SecondaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="2dp"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Material3.BodySmall"
                a:textColor="?attr/colorOnSurfaceVariant"
                tools:text="2007 · 11 songs" />

        </LinearLayout>

    </LinearLayout>

    <View
        a:layout_width="match_parent"
        a:layout_height="1dp"
        a:background="@color/taki_divider" />

    <androidx.core.widget.NestedScrollView
        a:layout_width="match_parent"
        a:layout_height="wrap_content">

        <TextView
            a:id="@+id/album_info_description"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:paddingHorizontal="24dp"
            a:paddingTop="16dp"
            a:paddingBottom="16dp"
            a:lineHeight="24sp"
            a:textColor="?attr/colorOnSurfaceVariant"
            a:textSize="16sp"
            tools:text="Album notes supplied by the music server." />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
