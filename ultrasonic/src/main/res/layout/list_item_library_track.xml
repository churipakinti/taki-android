<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/library_track_container"
    a:layout_width="match_parent"
    a:layout_height="76dp"
    a:background="?android:attr/selectableItemBackground"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingStart="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/library_track_cover"
        a:layout_width="56dp"
        a:layout_height="56dp"
        a:importantForAccessibility="no"
        a:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
        tools:src="@drawable/unknown_album" />

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_weight="1"
        a:orientation="vertical">

        <TextView
            a:id="@+id/library_track_title"
            style="@style/Ultrasonic.PrimaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            tools:text="Song title" />

        <TextView
            a:id="@+id/library_track_subtitle"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="3dp"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodySmall"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Artist · Album" />

    </LinearLayout>

    <ImageButton
        a:id="@+id/library_track_heart"
        a:layout_width="48dp"
        a:layout_height="48dp"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/download.menu_favorite"
        a:padding="12dp"
        a:src="@drawable/rating_heart_full"
        a:tint="@color/taki_accent_secondary"
        a:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        a:id="@+id/library_track_menu"
        a:layout_width="48dp"
        a:layout_height="48dp"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/search.more"
        a:padding="12dp"
        a:src="@drawable/ic_more_vert"
        a:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
