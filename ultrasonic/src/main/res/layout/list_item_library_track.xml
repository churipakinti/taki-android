<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/library_track_container"
    a:layout_width="match_parent"
    a:layout_height="@dimen/row_height_lg"
    a:background="?android:attr/selectableItemBackground"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingStart="@dimen/space_md">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/library_track_cover"
        a:layout_width="@dimen/artwork_thumb"
        a:layout_height="@dimen/artwork_thumb"
        a:importantForAccessibility="no"
        a:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Small"
        tools:src="@drawable/unknown_album" />

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="@dimen/space_md"
        a:layout_weight="1"
        a:orientation="vertical">

        <TextView
            a:id="@+id/library_track_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Title"
            tools:text="Song title" />

        <TextView
            a:id="@+id/library_track_subtitle"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="@dimen/space_text_tight"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Caption"
            tools:text="Artist · Album" />

    </LinearLayout>

    <ImageButton
        a:id="@+id/library_track_heart"
        a:layout_width="@dimen/touch_target_min"
        a:layout_height="@dimen/touch_target_min"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/download.menu_favorite"
        a:padding="@dimen/space_md"
        a:src="@drawable/rating_heart_full"
        a:tint="@color/taki_accent_secondary"
        a:visibility="gone"
        tools:visibility="visible" />

    <ImageButton
        a:id="@+id/library_track_menu"
        a:layout_width="@dimen/touch_target_min"
        a:layout_height="@dimen/touch_target_min"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/search.more"
        a:padding="@dimen/space_md"
        a:src="@drawable/ic_more_vert"
        a:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
