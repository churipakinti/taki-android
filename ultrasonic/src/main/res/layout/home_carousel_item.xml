<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="@dimen/artwork_card"
    a:layout_height="wrap_content"
    a:layout_marginEnd="@dimen/space_md"
    app:cardCornerRadius="@dimen/radius_sm"
    style="?attr/materialCardViewFilledStyle">

    <LinearLayout
        a:id="@+id/home_item_container"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:background="?android:attr/selectableItemBackground"
        a:clickable="true"
        a:focusable="true"
        a:orientation="vertical">

        <ImageView
            a:id="@+id/cover_art"
            a:layout_width="@dimen/artwork_card"
            a:layout_height="@dimen/artwork_card"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

        <TextView
            a:id="@+id/album_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginHorizontal="@dimen/space_md"
            a:layout_marginTop="@dimen/space_sm"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.TitleSmall"
            tools:text="Title" />

        <TextView
            a:id="@+id/album_artist"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginHorizontal="@dimen/space_md"
            a:layout_marginBottom="@dimen/space_md"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Caption"
            tools:text="Artist" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
