<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingHorizontal="@dimen/space_screen_horizontal"
    a:paddingVertical="@dimen/space_lg">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/select_album_art"
        a:layout_width="96dp"
        a:layout_height="96dp"
        a:contentDescription="@null"
        a:scaleType="centerCrop"
        a:src="@drawable/unknown_album"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Small" />

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="@dimen/space_lg"
        a:layout_weight="1"
        a:orientation="vertical">

        <TextView
            a:id="@+id/select_album_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:maxLines="2"
            a:textAppearance="@style/TextAppearance.Taki.Title"
            tools:text="Playlist name" />

        <TextView
            a:id="@+id/select_album_artist"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="@dimen/space_xs"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Caption"
            tools:text="Artist name" />

        <TextView
            a:id="@+id/select_album_meta"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="@dimen/space_text_tight"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Caption"
            tools:text="Rock · 1990 · 10 songs · 42:10" />

    </LinearLayout>

</LinearLayout>
