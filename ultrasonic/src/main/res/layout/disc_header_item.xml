<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingStart="24dp"
    a:paddingTop="20dp"
    a:paddingEnd="16dp"
    a:paddingBottom="10dp">

    <TextView
        a:id="@+id/disc_header_label"
        style="@style/Ultrasonic.SecondaryText"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:layout_marginEnd="12dp"
        a:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        a:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Disc 2" />

    <View
        a:layout_width="0dp"
        a:layout_height="1dp"
        a:layout_weight="1"
        a:background="?attr/colorOutlineVariant" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/disc_header_play"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="32dp"
        a:layout_height="32dp"
        a:layout_marginStart="12dp"
        a:contentDescription="@string/album.play_disc_description"
        app:icon="@drawable/media_start"
        app:iconSize="16dp"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        a:id="@+id/disc_header_download"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="32dp"
        a:layout_height="32dp"
        a:layout_marginStart="4dp"
        a:contentDescription="@string/album.download_disc_description"
        app:icon="@drawable/ic_menu_download"
        app:iconSize="16dp"
        app:iconTint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
