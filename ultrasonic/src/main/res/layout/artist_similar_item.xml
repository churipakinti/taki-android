<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/similar_artist_container"
    a:layout_width="112dp"
    a:layout_height="wrap_content"
    a:layout_marginEnd="12dp"
    a:background="?android:attr/selectableItemBackgroundBorderless"
    a:clickable="true"
    a:focusable="true"
    a:gravity="center_horizontal"
    a:orientation="vertical"
    a:paddingBottom="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/similar_artist_art"
        a:layout_width="104dp"
        a:layout_height="104dp"
        a:contentDescription="@string/artist.artwork_description"
        a:scaleType="centerCrop"
        a:src="@drawable/artist_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ultrasonic.Circle" />

    <TextView
        a:id="@+id/similar_artist_name"
        style="@style/Ultrasonic.PrimaryText"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:ellipsize="end"
        a:gravity="center"
        a:maxLines="2"
        a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        tools:text="Similar artist" />

</LinearLayout>
