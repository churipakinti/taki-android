<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="@dimen/row_height_lg"
    a:background="?android:attr/selectableItemBackground"
    a:clickable="true"
    a:focusable="true">

    <TextView
        a:id="@+id/disc_position"
        a:layout_width="32dp"
        a:layout_height="0dp"
        a:layout_marginStart="@dimen/space_sm"
        a:gravity="center"
        a:textAppearance="@style/TextAppearance.Taki.Caption"
        app:layout_constraintBottom_toBottomOf="@id/cover_art"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cover_art"
        tools:text="057" />

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/cover_art"
        a:layout_width="@dimen/artwork_thumb"
        a:layout_height="@dimen/artwork_thumb"
        a:layout_marginStart="@dimen/space_sm"
        a:contentDescription="@string/albumArt"
        a:scaleType="centerCrop"
        a:src="@drawable/unknown_album"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/disc_position"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Small" />

    <LinearLayout
        a:id="@+id/row_disc_details"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="@dimen/space_md"
        a:layout_marginEnd="@dimen/space_sm"
        a:gravity="center_vertical"
        a:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/cover_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cover_art"
        app:layout_constraintTop_toTopOf="@id/cover_art">

        <TextView
            a:id="@+id/disc_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Title"
            tools:text="Cantatas 150, 4, 71, 106" />

        <TextView
            a:id="@+id/disc_track_count"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="@dimen/space_text_tight"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Taki.Caption"
            tools:text="18 tracks" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
