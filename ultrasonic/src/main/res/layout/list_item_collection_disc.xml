<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:background="?android:attr/selectableItemBackground"
    a:clickable="true"
    a:focusable="true">

    <TextView
        a:id="@+id/disc_position"
        style="@style/Ultrasonic.SecondaryText"
        a:layout_width="32dp"
        a:layout_height="0dp"
        a:layout_marginStart="8dp"
        a:gravity="center"
        a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        a:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@id/cover_art_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cover_art_container"
        tools:text="057" />

    <com.google.android.material.card.MaterialCardView
        a:id="@+id/cover_art_container"
        a:layout_width="56dp"
        a:layout_height="56dp"
        a:layout_marginStart="8dp"
        a:layout_marginTop="8dp"
        a:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="3dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/disc_position"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            a:id="@+id/cover_art"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        a:id="@+id/row_disc_details"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_marginEnd="8dp"
        a:gravity="center_vertical"
        a:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/cover_art_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cover_art_container"
        app:layout_constraintTop_toTopOf="@id/cover_art_container">

        <TextView
            a:id="@+id/disc_title"
            style="@style/Ultrasonic.PrimaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            tools:text="Cantatas 150, 4, 71, 106" />

        <TextView
            a:id="@+id/disc_track_count"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="18 tracks" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
