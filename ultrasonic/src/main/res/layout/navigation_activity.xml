<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/navigation_root"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="?attr/colorSurface"
    a:orientation="vertical"
    tools:context="org.moire.ultrasonic.activity.NavigationActivity">

    <com.google.android.material.appbar.MaterialToolbar
        a:id="@+id/toolbar"
        a:layout_width="match_parent"
        a:layout_height="?attr/actionBarSize"
        a:background="?attr/colorSurface"
        a:elevation="3dp"
        app:navigationIconTint="?attr/colorOnSurface"
        app:titleTextColor="?attr/colorOnSurface" />

    <LinearLayout
        a:id="@+id/content_navigation_header"
        a:layout_width="match_parent"
        a:layout_height="56dp"
        a:gravity="center_vertical"
        a:orientation="horizontal"
        a:paddingHorizontal="8dp"
        a:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            a:id="@+id/content_back_button"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="48dp"
            a:layout_height="48dp"
            a:contentDescription="@string/common.navigate_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- One full-height container for all bottom-anchored shell layers. Draw order (bottom to
         top): the nav host fills it edge to edge, so screen content renders *behind* both the
         bottom nav and the mini-player; the bottom navigation is a translucent persistent
         layer docked to the bottom; the mini-player floats above the bottom nav with a gap.
         Nothing here is a reserved row - scrollable screens add the live floating-chrome inset
         (NavigationActivity.getContentBottomInset / bindFloatingChromeInset, mirrored by the
         Compose contentInsetFloatingChrome) to their own bottom padding so the last item
         clears whatever chrome is visible. NavigationActivity also sets the bottom nav's
         bottom padding (system nav-bar inset) and the mini-player's bottom margin (above the
         bottom nav, or above the system nav bar when the bottom nav is hidden). -->
    <FrameLayout
        a:id="@+id/nav_host_container"
        a:layout_width="match_parent"
        a:layout_height="0dp"
        a:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            a:id="@+id/nav_host_fragment"
            a:name="androidx.navigation.fragment.NavHostFragment"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/navigation_graph" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            a:id="@+id/bottom_navigation"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_gravity="bottom"
            a:background="@drawable/bg_bottom_navigation"
            app:itemIconTint="@color/bottom_navigation_item"
            app:itemTextColor="@color/bottom_navigation_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation" />

        <androidx.fragment.app.FragmentContainerView
            a:id="@+id/now_playing_fragment"
            a:name="org.moire.ultrasonic.fragment.NowPlayingFragment"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_gravity="bottom"
            a:layout_marginHorizontal="@dimen/mini_player_edge_margin"
            a:layout_marginBottom="@dimen/mini_player_edge_margin" />

    </FrameLayout>

</LinearLayout>
