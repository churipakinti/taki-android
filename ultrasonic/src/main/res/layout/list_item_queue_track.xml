<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/song_layout"
    a:layout_width="match_parent"
    a:layout_height="72dp"
    a:gravity="center_vertical"
    a:orientation="horizontal"
    a:paddingStart="16dp"
    a:paddingEnd="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/song_album_art"
        a:layout_width="52dp"
        a:layout_height="52dp"
        a:contentDescription="@string/albumArt"
        a:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
        tools:src="@drawable/unknown_album" />

    <LinearLayout
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_weight="1"
        a:orientation="vertical">

        <TextView
            a:id="@+id/song_title"
            style="@style/Ultrasonic.PrimaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:drawablePadding="6dp"
            a:ellipsize="marquee"
            a:marqueeRepeatLimit="marquee_forever"
            a:scrollHorizontally="true"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            tools:text="Song title" />

        <TextView
            a:id="@+id/song_artist"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="2dp"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Artist" />
    </LinearLayout>

    <ImageView
        a:id="@+id/song_drag"
        a:layout_width="48dp"
        a:layout_height="48dp"
        a:contentDescription="@string/playlist.move"
        a:padding="12dp"
        a:src="@drawable/ic_drag_vertical" />

    <CheckedTextView
        a:id="@+id/song_check"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <ImageView
        a:id="@+id/song_star"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <TextView
        a:id="@+id/song_track"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <TextView
        a:id="@+id/song_duration"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <ImageView
        a:id="@+id/song_status_image"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        a:id="@+id/song_status_progress"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

    <View
        a:id="@+id/song_menu"
        a:layout_width="0dp"
        a:layout_height="0dp"
        a:visibility="gone" />

</LinearLayout>
