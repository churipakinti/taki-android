<?xml version="1.0" encoding="utf-8"?>
<!--
    Stacked-cover composition: up to 3 square covers layered back-to-front using
    percent-based ConstraintLayout bias, so it scales cleanly
    at any container size (small grid card or large detail header) without any code-time math.
    Callers show/hide stack_back/stack_middle depending on how many distinct covers a Collection
    actually has (docs section 4 - a single-cover Collection must show one clean cover, not 3
    copies of the same image).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        a:id="@+id/stack_back"
        a:layout_width="0dp"
        a:layout_height="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="6dp"
        app:cardElevation="1dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.82"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.82">

        <ImageView
            a:id="@+id/stack_back_image"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@null"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        a:id="@+id/stack_middle"
        a:layout_width="0dp"
        a:layout_height="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="6dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.82"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.82">

        <ImageView
            a:id="@+id/stack_middle_image"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@null"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        a:id="@+id/stack_front"
        a:layout_width="0dp"
        a:layout_height="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="6dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.82"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.82">

        <ImageView
            a:id="@+id/stack_front_image"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
