<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/containing_layout"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:background="?android:attr/selectableItemBackground"
    a:clickable="true"
    a:focusable="true">

    <com.google.android.material.card.MaterialCardView
        a:id="@+id/cover_art_container"
        a:layout_width="72dp"
        a:layout_height="72dp"
        a:layout_marginStart="8dp"
        a:layout_marginTop="8dp"
        a:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="3dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            a:id="@+id/cover_art"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        a:id="@+id/row_album_details"
        a:layout_width="0dp"
        a:layout_height="88dp"
        a:layout_marginStart="12dp"
        a:drawablePadding="6dip"
        a:gravity="center_vertical"
        a:minHeight="56dip"
        a:orientation="vertical"
        a:paddingStart="3dip"
        a:paddingEnd="3dip"
        a:textAppearance="?android:attr/textAppearanceMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cover_art_container"
        app:layout_constraintStart_toEndOf="@+id/cover_art_container"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            a:id="@+id/album_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="marquee"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            tools:text="TITLE" />

        <TextView
            a:id="@+id/album_artist"
            style="@style/Ultrasonic.SecondaryText"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:singleLine="true"
            a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="ARTIST" />

    </LinearLayout>

    <ImageView
        a:id="@+id/album_star"
        a:layout_width="38dp"
        a:padding="4dp"
        a:layout_height="38dp"
        a:layout_marginStart="16dp"
        a:layout_marginTop="16dp"
        a:layout_marginEnd="20dp"
        a:background="@android:color/transparent"
        a:gravity="center_horizontal"
        a:src="@drawable/rating_star_hollow"
        a:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/row_album_details"
        app:layout_constraintStart_toEndOf="@+id/row_album_details"
        app:layout_constraintTop_toTopOf="parent"
        a:contentDescription="@string/download.menu_star" />

</androidx.constraintlayout.widget.ConstraintLayout>
