<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:orientation="vertical">

    <TextView
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:paddingStart="@dimen/space_screen_horizontal"
        a:paddingTop="@dimen/space_lg"
        a:paddingEnd="@dimen/space_screen_horizontal"
        a:paddingBottom="@dimen/space_sm"
        a:text="@string/search.title"
        a:textAppearance="@style/TextAppearance.Taki.Hero" />

    <com.google.android.material.card.MaterialCardView
        a:layout_width="match_parent"
        a:layout_height="@dimen/row_height_sm"
        a:layout_marginHorizontal="@dimen/space_screen_horizontal"
        a:layout_marginBottom="@dimen/space_md"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="@dimen/border_thin">

        <androidx.appcompat.widget.SearchView
            a:id="@+id/search_field"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@string/button_bar.search"
            app:iconifiedByDefault="false"
            app:queryHint="@string/button_bar.search" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        a:id="@+id/recent_searches_panel"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingHorizontal="@dimen/space_screen_horizontal"
        a:visibility="gone">

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="@dimen/touch_target_min"
            a:gravity="center_vertical"
            a:orientation="horizontal">

            <TextView
                a:layout_width="0dp"
                a:layout_height="wrap_content"
                a:layout_weight="1"
                a:text="@string/search.recent"
                a:textAppearance="@style/TextAppearance.Taki.SectionHeader" />

            <com.google.android.material.button.MaterialButton
                a:id="@+id/recent_searches_clear"
                style="@style/Widget.Material3.Button.TextButton"
                a:layout_width="wrap_content"
                a:layout_height="@dimen/touch_target_min"
                a:text="@string/search.clear_all"
                a:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <LinearLayout
            a:id="@+id/recent_searches_list"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical" />

    </LinearLayout>

    <include layout="@layout/list_parts_empty_view" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        a:id="@+id/swipe_refresh_view"
        a:layout_width="match_parent"
        a:layout_height="0dip"
        a:layout_weight="1.0">

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/recycler_view"
            a:layout_width="match_parent"
            a:layout_height="0dip"
            a:layout_weight="1.0" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
