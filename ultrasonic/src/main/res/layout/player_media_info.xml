<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/download_button_bar_flipper"
    a:layout_width="fill_parent"
    a:layout_height="wrap_content"
    >

    <ImageView
        a:id="@+id/song_rating_heart"
        a:layout_width="@dimen/player_info_favorite_target"
        a:layout_height="@dimen/player_info_favorite_target"
        a:background="@android:color/transparent"
        a:contentDescription="@string/download.menu_star"
        a:focusable="true"
        a:padding="10dp"
        a:scaleType="fitCenter"
        a:src="@drawable/rating_heart_hollow_layered"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        a:id="@+id/current_playing_song"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:background="?android:attr/selectableItemBackground"
        a:clickable="true"
        a:ellipsize="marquee"
        a:marqueeRepeatLimit="marquee_forever"
        a:scrollHorizontally="true"
        a:focusable="true"
        a:gravity="left"
        a:layout_marginStart="@dimen/space_md"
        a:singleLine="true"
        a:textAppearance="@style/TextAppearance.Taki.Hero"
        a:layout_marginEnd="@dimen/space_sm"
        app:layout_constraintBottom_toBottomOf="@id/song_rating_heart"
        app:layout_constraintEnd_toStartOf="@+id/song_rating_heart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <TextView
        a:id="@+id/current_playing_artist"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/player_info_artist_spacing"
        a:layout_marginStart="@dimen/space_md"
        a:background="?android:attr/selectableItemBackground"
        a:clickable="true"
        a:ellipsize="end"
        a:focusable="true"
        a:gravity="center_vertical|left"
        a:minHeight="@dimen/touch_target_min"
        a:singleLine="true"
        a:textAppearance="@style/TextAppearance.Taki.Caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/current_playing_song"
        tools:text="Artist" />

</androidx.constraintlayout.widget.ConstraintLayout>
