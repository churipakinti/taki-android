<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/card"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:layout_marginHorizontal="6dp"
    a:layout_marginVertical="8dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        a:id="@+id/containing_layout"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:background="?android:attr/selectableItemBackground"
        a:clickable="true"
        a:focusable="true">

        <ImageView
            a:id="@+id/cover_art"
            a:layout_width="match_parent"
            a:layout_height="0dp"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            a:contentDescription="@string/albumArt" />

        <LinearLayout
            a:id="@+id/row_album_details"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:gravity="center_vertical"
            a:orientation="vertical"
            a:paddingTop="8dp"
            a:paddingBottom="8dp"
            app:layout_constraintEnd_toEndOf="@+id/cover_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cover_art">

            <TextView
                a:id="@+id/album_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                tools:text="Title" />

            <TextView
                a:id="@+id/album_artist"
                style="@style/Ultrasonic.SecondaryText"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                a:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Artist" />

        </LinearLayout>

        <ImageView
            a:id="@+id/album_star"
            a:layout_width="38dp"
            a:layout_height="38dp"
            a:background="@android:color/transparent"
            a:contentDescription="@string/download.menu_star"
            a:gravity="center_horizontal"
            a:padding="4dp"
            a:src="@drawable/rating_star_hollow"
            a:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/cover_art"
            app:layout_constraintEnd_toEndOf="@+id/cover_art" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
