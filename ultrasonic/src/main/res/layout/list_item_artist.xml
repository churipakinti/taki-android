<RelativeLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:id="@+id/containing_layout"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:background="?android:attr/selectableItemBackground"
    a:clickable="true"
    a:focusable="true"
    a:minHeight="@dimen/row_height_lg">

    <TextView
        a:id="@+id/row_section"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:gravity="center_horizontal|center_vertical"
        a:minWidth="56dip"
        a:minHeight="56dip"
        a:paddingStart="@dimen/space_sm"
        a:paddingEnd="@dimen/space_sm"
        a:textAppearance="@style/TextAppearance.Taki.SectionHeader"
        tools:text="A" />

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/cover_art"
        a:layout_width="@dimen/artwork_thumb"
        a:layout_height="@dimen/artwork_thumb"
        a:layout_gravity="center_horizontal|center_vertical"
        a:layout_marginStart="@dimen/space_sm"
        a:layout_marginTop="@dimen/space_sm"
        a:layout_marginEnd="@dimen/space_md"
        a:layout_marginBottom="@dimen/space_sm"
        a:layout_toEndOf="@+id/row_section"
        a:scaleType="centerCrop"
        a:src="@drawable/artist_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ultrasonic.Circle" />

    <TextView
        a:id="@+id/row_artist_name"
        a:layout_width="fill_parent"
        a:layout_height="wrap_content"
        a:layout_marginEnd="@dimen/space_md"
        a:layout_toEndOf="@+id/cover_art"
        a:drawablePadding="@dimen/space_xs"
        a:gravity="center_vertical"
        a:minHeight="@dimen/row_height_lg"
        a:textAppearance="@style/TextAppearance.Taki.Title" />

</RelativeLayout>
