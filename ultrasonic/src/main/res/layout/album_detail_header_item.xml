<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical">

    <FrameLayout
        a:id="@+id/album_detail_hero"
        a:layout_width="match_parent"
        a:layout_height="300dp">

        <ImageView
            a:id="@+id/album_detail_art"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:contentDescription="@string/album.artwork_description"
            a:scaleType="centerCrop"
            a:src="@drawable/unknown_album" />

        <View
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            a:background="@drawable/bg_artist_hero_gradient"
            a:importantForAccessibility="no" />

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_gravity="bottom"
            a:orientation="vertical"
            a:paddingStart="@dimen/space_lg"
            a:paddingEnd="@dimen/space_lg"
            a:paddingBottom="@dimen/space_lg">

            <TextView
                a:id="@+id/album_detail_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:maxLines="2"
                a:shadowColor="#99000000"
                a:shadowDx="0"
                a:shadowDy="1"
                a:shadowRadius="3"
                a:textAppearance="@style/TextAppearance.Taki.Title"
                tools:text="El Duelo" />

            <TextView
                a:id="@+id/album_detail_artist"
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_xs"
                a:background="?attr/selectableItemBackgroundBorderless"
                a:ellipsize="end"
                a:minHeight="@dimen/touch_target_min"
                a:gravity="center_vertical"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="Héroes del Silencio" />

            <TextView
                a:id="@+id/album_detail_subtitle"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:singleLine="true"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="1990 · 10 songs" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center_vertical|end"
        a:orientation="horizontal"
        a:paddingStart="@dimen/space_screen_horizontal"
        a:paddingTop="@dimen/space_sm"
        a:paddingEnd="@dimen/space_screen_horizontal"
        a:paddingBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            a:id="@+id/album_detail_star"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:contentDescription="@string/album.star_description"
            a:visibility="gone"
            app:icon="@drawable/rating_heart_hollow"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/album_detail_download"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:contentDescription="@string/album.download_description"
            app:icon="@drawable/ic_menu_download"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/album_detail_info"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:contentDescription="@string/album.info_description"
            a:visibility="gone"
            app:icon="@drawable/ic_info_outline"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/album_detail_shuffle"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:contentDescription="@string/album.shuffle_description"
            app:icon="@drawable/media_shuffle"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/album_detail_more"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:layout_marginEnd="@dimen/space_xs"
            a:contentDescription="@string/album.more_description"
            a:visibility="gone"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="@dimen/icon_size_sm"
            app:iconTint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            a:id="@+id/album_detail_play"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:contentDescription="@string/album.play_description"
            a:src="@drawable/media_start"
            app:backgroundTint="?attr/colorOnSurface"
            app:borderWidth="0dp"
            app:elevation="0dp"
            app:fabCustomSize="@dimen/touch_target_min"
            app:maxImageSize="@dimen/icon_size_md"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ultrasonic.Circle"
            app:tint="?attr/colorSurface" />

    </LinearLayout>

</LinearLayout>
