<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:clickable="true"
    a:focusable="true"
    a:orientation="vertical"
    a:paddingHorizontal="@dimen/space_md"
    a:paddingTop="@dimen/space_sm"
    a:paddingBottom="@dimen/space_sm">

    <org.moire.ultrasonic.view.SquareFrameLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            a:id="@+id/playlist_cover_container"
            a:layout_width="match_parent"
            a:layout_height="match_parent"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <include layout="@layout/playlist_cover_collage" />

        </com.google.android.material.card.MaterialCardView>

    </org.moire.ultrasonic.view.SquareFrameLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="@dimen/space_sm"
        a:gravity="center_vertical"
        a:orientation="horizontal">

        <LinearLayout
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:orientation="vertical">

            <TextView
                a:id="@+id/playlist_name"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="2"
                a:textAppearance="@style/TextAppearance.Taki.TitleSmall"
                tools:text="Random Mix" />

            <TextView
                a:id="@+id/playlist_song_count"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:layout_marginTop="@dimen/space_text_tight"
                a:ellipsize="end"
                a:maxLines="1"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="24 songs" />

            <TextView
                a:id="@+id/playlist_download_status"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="1"
                a:textAppearance="@style/TextAppearance.Taki.Caption"
                tools:text="Downloaded" />

        </LinearLayout>

        <FrameLayout
            a:id="@+id/playlist_action_container"
            a:layout_width="@dimen/touch_target_min"
            a:layout_height="@dimen/touch_target_min"
            a:layout_marginStart="@dimen/space_xs">

            <com.google.android.material.button.MaterialButton
                a:id="@+id/playlist_menu"
                style="@style/Widget.Material3.Button.IconButton"
                a:layout_width="match_parent"
                a:layout_height="match_parent"
                a:focusable="false"
                a:contentDescription="@string/playlist.menu_description"
                app:icon="@drawable/ic_more_vert"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <ProgressBar
                a:id="@+id/playlist_download_progress"
                a:layout_width="20dp"
                a:layout_height="20dp"
                a:layout_gravity="center"
                a:indeterminate="true"
                a:indeterminateTint="?attr/colorOnSurfaceVariant"
                a:visibility="gone"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
