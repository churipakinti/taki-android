<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="fill_parent"
    a:layout_height="wrap_content"
    a:layout_marginTop="@dimen/player_section_spacing"
    a:gravity="center_vertical"
    a:orientation="horizontal" >

    <Button
        a:id="@+id/button_shuffle"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="48dp"
        a:layout_gravity="center"
        a:layout_weight="1"
        a:adjustViewBounds="true"
        a:contentDescription="@string/buttons.shuffle"
        a:focusable="true"
        a:scaleType="fitCenter"
        app:icon="@drawable/media_shuffle"
        app:iconGravity="textEnd"
        app:iconSize="@dimen/player_mode_icon" />

    <org.moire.ultrasonic.view.AutoRepeatButton
        a:id="@+id/button_previous"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="48dp"
        a:layout_gravity="center"
        a:layout_weight="2"
        a:adjustViewBounds="true"
        a:contentDescription="@string/buttons.previous"
        a:focusable="true"
        a:scaleType="fitCenter"
        app:icon="@drawable/media_backward_shadow"
        app:iconGravity="textEnd"
        app:iconSize="@dimen/player_skip_icon"
        app:iconTint="?attr/colorOnSurface" />

    <Button
        a:id="@+id/button_start"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="@dimen/player_transport_height"
        a:layout_weight="2"
        a:adjustViewBounds="true"
        a:focusable="true"
        a:scaleType="fitCenter"
        tools:visibility="gone"
        a:contentDescription="@string/buttons.play"
        app:icon="@drawable/media_start_shadow"
        app:iconGravity="textEnd"
        app:backgroundTint="?attr/colorOnSurface"
        app:iconSize="@dimen/player_transport_icon"
        app:iconTint="@color/taki_on_accent" />

    <Button
        a:id="@+id/button_pause"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="@dimen/player_transport_height"
        a:layout_weight="2"
        a:adjustViewBounds="true"
        a:contentDescription="@string/buttons.pause"
        a:focusable="true"
        a:scaleType="fitCenter"
        app:icon="@drawable/media_pause_shadow"
        app:iconGravity="textEnd"
        app:backgroundTint="?attr/colorOnSurface"
        app:iconSize="@dimen/player_transport_icon"
        app:iconTint="@color/taki_on_accent" />

    <Button
        a:id="@+id/button_stop"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="@dimen/player_transport_height"
        a:layout_weight="2"
        a:adjustViewBounds="true"
        a:focusable="true"
        a:scaleType="fitCenter"
        tools:visibility="gone"
        a:contentDescription="@string/buttons.stop"
        app:icon="@drawable/media_stop"
        app:iconGravity="textEnd"
        app:iconSize="@dimen/player_transport_icon" />

    <org.moire.ultrasonic.view.AutoRepeatButton
        a:id="@+id/button_next"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="48dp"
        a:layout_gravity="center"
        a:layout_weight="2"
        a:adjustViewBounds="true"
        a:contentDescription="@string/buttons.next"
        a:focusable="true"
        a:scaleType="fitCenter"
        app:icon="@drawable/media_forward_shadow"
        app:iconGravity="textEnd"
        app:iconSize="@dimen/player_skip_icon"
        app:iconTint="?attr/colorOnSurface" />

    <Button
        a:id="@+id/button_repeat"
        style="@style/Widget.Material3.Button.IconButton"
        a:layout_width="0dip"
        a:layout_height="48dp"
        a:layout_gravity="center"
        a:layout_weight="1"
        a:adjustViewBounds="true"
        a:contentDescription="@string/buttons.repeat"
        a:focusable="true"
        a:scaleType="fitCenter"
        app:icon="@drawable/media_repeat_off"
        app:iconGravity="textEnd"
        app:iconSize="@dimen/player_mode_icon" />

    </LinearLayout>
