<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:id="@+id/current_playing_playlist_flipper"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="@color/taki_black">

    <androidx.constraintlayout.widget.ConstraintLayout
        a:id="@+id/current_playing_album_art_layout"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:padding="16dp">

        <com.google.android.material.button.MaterialButton
            a:id="@+id/player_back"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="48dp"
            a:layout_height="48dp"
            a:contentDescription="@string/player.back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/player_overflow"
            style="@style/Widget.Material3.Button.IconButton"
            a:layout_width="48dp"
            a:layout_height="48dp"
            a:contentDescription="@string/player.options"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            a:id="@+id/current_playing_queue_loading"
            a:layout_width="0dp"
            a:layout_height="2dp"
            a:clickable="false"
            a:focusable="false"
            a:importantForAccessibility="no"
            a:indeterminate="true"
            a:visibility="gone"
            app:indicatorColor="@color/taki_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_back"
            app:trackColor="@color/taki_divider"
            app:trackCornerRadius="0dp"
            app:trackThickness="2dp" />

        <com.google.android.material.imageview.ShapeableImageView
            a:id="@+id/current_playing_album_art_image"
            a:layout_width="0dp"
            a:layout_height="0dp"
            a:layout_marginStart="48dp"
            a:layout_marginTop="12dp"
            a:layout_marginEnd="32dp"
            a:layout_marginBottom="20dp"
            a:contentDescription="@string/albumArt"
            a:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/player_land_controls"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_back"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Taki.Medium" />

        <LinearLayout
            a:id="@+id/player_land_controls"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="16dp"
            a:layout_marginEnd="48dp"
            a:gravity="center_vertical"
            a:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/current_playing_album_art_image"
            app:layout_constraintTop_toBottomOf="@id/player_overflow">

            <include layout="@layout/player_media_info" />

            <include layout="@layout/player_slider" />

            <include layout="@layout/media_buttons" />

            <include layout="@layout/player_secondary_controls" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        a:id="@+id/playlist"
        layout="@layout/current_playlist" />

</ViewFlipper>
