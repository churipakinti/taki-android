<?xml version="1.0" encoding="utf-8"?>
<!--
    Now Playing control panel. Reads as a grouping of the controls, not a raised card:
    a low surface tone (colorSurfaceContainer, not ...High) and a radius from the shared
    scale (player_panel_corner_radius -> radius_lg). Depth in Taki is tonal, not shadow -
    see visual guide section 4.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainer" />

    <corners android:radius="@dimen/player_panel_corner_radius" />

</shape>
