<?xml version="1.0" encoding="utf-8"?>
<!--
    Mini-player background. Same language as the full player's control panel
    (bg_player_panel): a low surface tone that groups the row without reading as a
    raised card, radius from the shared scale (radius_md for this smaller element).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="?attr/colorSurfaceContainer" />

    <corners android:radius="@dimen/radius_md" />

</shape>
