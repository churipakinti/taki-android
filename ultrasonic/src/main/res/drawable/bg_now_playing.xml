<?xml version="1.0" encoding="utf-8"?>
<!--
    Mini-player background: floating chrome (V2 section 13). A `surface` tone at ~0.87
    opacity (taki_surface_floating) - the top, more translucent floating layer, sitting over
    Home content - plus a 1dp tonal edge (taki_edge_highlight, ~7% ivory); no drop shadow,
    no bright border. Radius from the shared scale (radius_md). Alphas match
    TakiAtmosphere.MINI_PLAYER_SURFACE_ALPHA in the Compose theme.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/taki_surface_floating" />

    <stroke
        android:width="1dp"
        android:color="@color/taki_edge_highlight" />

    <corners android:radius="@dimen/radius_md" />

</shape>
