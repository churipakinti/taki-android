<!--
  Shared "nothing here" glyph for list_parts_empty_view.xml (search no-match, empty playlist,
  empty queue, etc.). Was a generic loading/brightness-burst icon left over from the original
  Ultrasonic fork, never touched by the Material3/Taki visual pass: reported as visibly "the
  old icon" against an otherwise modernized empty state (TAKI_BETA_COMPLETION_PLAN.md P1).
  Reuses the same path as ic_menu_playlists.xml (already the app's playlist/queue glyph
  elsewhere) instead of inventing a new one, so an empty playlist/queue/song list reads as "no
  tracks" rather than an unrelated shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="@android:color/white"
      android:pathData="M4,10h12v2L4,12zM4,6h12v2L4,8zM4,14h8v2L4,16zM14,14v6l5,-3z"/>
</vector>
