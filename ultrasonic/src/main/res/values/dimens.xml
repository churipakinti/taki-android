<?xml version="1.0" encoding="utf-8"?>
<!--
  Taki design tokens — dimensions.

  The single source of truth for spacing, corner radii, icon sizes and touch/row
  targets. Layouts and drawables should reference these instead of inventing raw dp
  values. See docs/technical/TAKI_GUIA_VISUAL_Y_LENGUAJE.md section 18 for the rationale
  and how each token maps to the audited screens.

  tools:ignore="UnusedResources": this is a shared foundation consumed incrementally by
  the UI passes (#4/#5/#7/#11); some steps of a scale are intentionally in place before
  their first caller so the scale stays complete and gap-free.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">

    <!-- Spacing scale. 4dp base; every gutter, padding and gap picks one of these. -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_2xl">32dp</dimen>

    <!-- Semantic spacing aliases (keep these two in lockstep with the screens). -->
    <!-- The one screen edge gutter for primary content. -->
    <dimen name="space_screen_horizontal">@dimen/space_lg</dimen>
    <!-- Vertical gap between Home / Library shelves and detail sections. -->
    <dimen name="space_section_gap">@dimen/space_xl</dimen>
    <!-- Gap between a title and its immediate subtitle / metadata line. -->
    <dimen name="space_text_tight">@dimen/space_xxs</dimen>

    <!-- Corner radius scale. Artwork and small cards stay tight; panels a little softer. -->
    <dimen name="radius_xs">4dp</dimen>
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">20dp</dimen>

    <!-- Icon sizes for action / control glyphs (not artwork). -->
    <dimen name="icon_size_sm">18dp</dimen>
    <dimen name="icon_size_md">24dp</dimen>
    <dimen name="icon_size_lg">32dp</dimen>

    <!-- Touch targets. 48dp is the floor for anything tappable. -->
    <dimen name="touch_target_min">48dp</dimen>

    <!-- List / content row heights. -->
    <dimen name="row_height_sm">56dp</dimen>
    <dimen name="row_height_md">64dp</dimen>
    <dimen name="row_height_lg">72dp</dimen>

    <!-- Artwork footprints. Artwork is the primary carrier of colour on music screens. -->
    <dimen name="artwork_thumb">56dp</dimen>
    <dimen name="artwork_mini">48dp</dimen>
    <dimen name="artwork_shelf_compact">104dp</dimen>
    <dimen name="artwork_card">140dp</dimen>

    <!-- Home featured ("mix") card. TAKI_DESIGN_SYSTEM_V2.md section 10.1. -->
    <dimen name="featured_card_height">156dp</dimen>
    <dimen name="featured_card_artwork">124dp</dimen>

    <!-- Library "Your music" 2-column personal-destination card (V2 section 11.3). -->
    <dimen name="library_card_height">80dp</dimen>

    <!-- Search field (V2 section 11 / north star): a quiet tonal container, not a Material box. -->
    <dimen name="search_field_height">52dp</dimen>

    <!-- Album / collection detail (V2 sections 1, 7, 12; issue #10 phase 4A). The hero cover is
         responsive between these two - screenWidth minus the gutters, clamped - so it never
         hard-codes one phone width. The primary Play button is the V2 section 6 transport
         exception (64dp). The track list stays quiet and compact: a 56dp minimum row that
         grows for a wrapped long title, with a narrow number column. -->
    <dimen name="album_hero_artwork_min">240dp</dimen>
    <dimen name="album_hero_artwork_max">320dp</dimen>
    <dimen name="detail_primary_action">64dp</dimen>
    <dimen name="track_row_min_height">56dp</dimen>
    <dimen name="track_number_column">28dp</dimen>

    <!-- Floating shell (V2 sections 13-14). Both the bottom nav and the mini-player overlay
         scrollable content; nothing is a reserved row. mini_player_edge_margin doubles as the
         mini-player's screen-edge inset and the equal 16dp gap it leaves above the bottom nav,
         so it rests optically centred in that band. bottom_nav_height is a pre-layout estimate
         of the Material 3 labelled bottom-nav content height (once laid out the real measured
         height is used instead; its background also fills the system nav-bar inset behind it).
         content_inset_floating_chrome is the *mini-player band only* - 16 (gap above
         content) + 64 (mini_player_height) + 16 (gap above the bottom nav) - and is the static
         fallback for XML scroll views; NavigationActivity.getContentBottomInset() adds the live
         system nav-bar + bottom_nav_height on top per whatever chrome is actually visible. -->
    <dimen name="mini_player_height">64dp</dimen>
    <dimen name="mini_player_edge_margin">16dp</dimen>
    <dimen name="bottom_nav_height">80dp</dimen>
    <dimen name="content_inset_floating_chrome">96dp</dimen>

    <!-- Elevation / borders. Depth is tonal by default; these are the rare exceptions. -->
    <dimen name="elevation_raised">3dp</dimen>
    <dimen name="border_thin">1dp</dimen>

</resources>
