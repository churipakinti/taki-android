<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearanceOverlay.Ultrasonic.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Taki radius tokens as shape overlays, for ShapeableImageView / MaterialCardView.
         Keep the sizes in lockstep with @dimen/radius_sm and @dimen/radius_md. -->
    <style name="ShapeAppearanceOverlay.Taki.Small" parent="">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="Ultrasonic.SecondaryText" parent="">
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Ultrasonic.PrimaryText" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style tools:ignore="PrivateResource" name="Widget.ChipDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="shapeAppearance">?attr/shapeAppearanceSmallComponent</item>
        <item name="boxStrokeColor">?attr/colorOutlineVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
    </style>

</resources>

